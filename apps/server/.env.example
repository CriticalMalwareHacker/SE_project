OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Neon pooled connection string (use the hostname ending in -pooler).
DATABASE_URL=
# Managed Neon Auth service URLs are loaded from the root .env.local.
# They are public identifiers, but keep NEON_AUTH_JWKS_URL server-side.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Long random value used to sign local Flask session cookies. Keep server-side.
FLASK_SECRET_KEY=
# Optional: set to 0 to fail startup instead of using local SQLite when DATABASE_URL is unreachable.
GUARDLOOP_ALLOW_SQLITE_FALLBACK=1
# Optional per-agent routing: openrouter or nvidia. Keys remain server-side.
# Optional: LLM_PROVIDER_ATTACK=openrouter|nvidia (same pattern for other roles)
MODEL_ATTACK=
MODEL_VERIFY=
MODEL_FIX=
MODEL_CONFIRM=
MODEL_REPORT=
MODEL_TARGET=
MAX_TOKENS_PER_CALL=2048
MAX_LLM_CALLS_PER_SCAN=150
LLM_CONCURRENCY=3
TARGET_BASE_URL=http://127.0.0.1:5001
TARGET_ADMIN_TOKEN=change-me
SERVER_PORT=5000
WEB_ORIGIN=http://localhost:5173
